# Paths excluded from the plugin package deployed to wordpress.org.
# Keep grouped and deduplicated - this file is easy to let rot.
#
# CHANGELOG.md used to be required at runtime: the admin Changelog tab read and
# rendered it through league/commonmark. That dependency is gone - the tab now
# links to the published changelog on GitHub - so the file no longer ships.
# readme.txt carries the changelog wordpress.org displays.

# Version control and CI
/.git
/.github
/.deployment
.deployment
.gitignore
.gitattributes
.vipgoci_lint_skip_folders
/.vipgoci_phpcs_skip_folders
.vipgoci_phpcs_skip_folders

# Editor and agent config
/.vscode
/.cursor
/.claude
.editorconfig
courier-notices.code-workspace

# wordpress.org assets live outside the package
/.wordpress-org

# Build sources and tooling
/node_modules
/assets
/bin
/tools
/zip
webpack.config.js
babel.config.js
package.json
package-lock.json
yarn.lock
yarn-error.log
.yarnrc.yml
gulpfile.babel.js

# Linting, static analysis, formatting
phpcs.xml
phpcs.xml.dist
.php-cs-fixer.dist.php
.php-cs-fixer.cache
phpstan.neon.dist
phpstan-baseline.neon
.phpstan.neon.dist
.phpstan.neon.dist.yml
.phpstan-baseline.neon
.phplint.yml
.eslintrc.js
.eslintignore
.prettierrc.js
lint-staged.config.js
commitlint.config.js
.husky
.codeclimate.yml

# Tests
/tests
phpunit.xml
phpunit-integration.xml
jest.config.js
/test-results
/coverage-js
.phpunit.result.cache
.phpunit-integration.result.cache

# Documentation not intended for the wordpress.org package
/docs
/wiki
phpdoc.dist.xml
README.md
FAQ.md
CHANGELOG.md

# Release tooling
release-please-config.json
.release-please-manifest.json
renovate.json

# Composer manifests - vendor/ itself ships, these do not
composer.json
composer.lock
/vendor/wp-coding-standards
/vendor/squizlabs
/vendor/dealerdirect
/vendor/phpcompatibility
/vendor/php-parallel-lint

# Local and build artifacts
.linchpin.json
config.yml
courier-notices.zip
output.log
docker_tag
DOCKER_ENV
.distignore
