<?xml version="1.0"?>
<ruleset name="Courier Notices">
	<description>Linchpin coding standards with Courier Notices project overrides.</description>

	<!--
		Base standard comes from linchpin/coding-standards.

		We use Linchpin-Minimum rather than the full Linchpin ruleset, matching
		linchpin-blocks. Measured against this codebase on 2026-08-10:

		  Linchpin-Minimum   96 violations across 9 sniffs - all security,
		                     performance and correctness, zero style noise
		  Linchpin (full)    899 violations, of which ~666 are two auto-fixable
		                     style sniffs (long array syntax 438, multiple empty
		                     lines 228)

		Moving to full Linchpin is worth doing, but it is a mechanical reformat
		that touches nearly every file and should land as its own PR rather than
		riding along with feature work. Tracked in docs/2.0-MIGRATION-PLAN.md.
	-->
	<rule ref="Linchpin-Minimum"/>

	<!--
		testVersion is REQUIRED, not optional. Linchpin-Minimum pulls in
		PHPCompatibility, and without testVersion its Sniff.php passes null to
		trim() and throws an internal exception that ABORTS checking on every
		file - reporting "an error occurred during processing" instead of real
		violations. Keep this in sync with "Requires PHP" in courier-notices.php.
	-->
	<config name="testVersion" value="8.2-8.4"/>

	<!-- Only sniff PHP files. -->
	<arg name="extensions" value="php"/>

	<!--
		Paths in scope.

		NOTE: passing explicit file paths on the command line OVERRIDES this
		list. lint-staged does exactly that so it can lint only staged files,
		which means a staged file outside this list still gets checked. Keep
		this list complete anyway - it is what a bare `composer phpcs` uses.
	-->
	<file>./courier-notices.php</file>
	<file>./includes</file>
	<file>./templates</file>
	<file>./uninstall.php</file>

	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>./vendor/*</exclude-pattern>
	<exclude-pattern>./vendor-prefixed/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>./tools/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.asset.php</exclude-pattern>

	<!--
		Vendored fork of core's WP_List_Table - a copy of WordPress core code,
		not ours to restyle. Slated for deletion when the React admin replaces
		the Design Studio table (migration plan, Phase 5).
	-->
	<exclude-pattern>./includes/Helper/WP_List_Table.php</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="cache"/>
	<arg name="parallel" value="8"/>
	<arg value="s"/>

	<!--
		Linchpin-Minimum does not include PrefixAllGlobals. We want it: this
		plugin ships on wordpress.org, where an unprefixed global is both a
		review finding and a real collision risk. It currently flags legitimate
		back-compat hooks such as `courier_notice_labels` and `courier_excerpt`,
		which are public API and cannot simply be renamed - see the back-compat
		landmines section of the migration plan.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="CourierNotices"/>
				<element value="courier_notices"/>
			</property>
		</properties>
	</rule>

	<!--
		Template variables are NOT globals here, so the variable-prefix check is
		a false positive in templates/ (79 of them).

		Core\View::render() assigns them with ${$key} = $value inside a method
		and then includes the template from that same method, so they are
		function-scoped. The sniff cannot see that and assumes global scope.

		Function and hook name prefixing still applies to templates - only the
		variable check is excluded.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>./templates/*</exclude-pattern>
		<exclude-pattern>./src/blocks/*/render.php</exclude-pattern>
	</rule>

	<!-- Custom capabilities registered by Install::add_capabilities(). -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_courier_notices"/>
				<element value="delete_courier_notices"/>
				<element value="delete_others_courier_notices"/>
				<element value="edit_published_courier_notices"/>
				<element value="edit_others_courier_notices"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="courier-notices"/>
			</property>
		</properties>
	</rule>

	<!-- Minimum supported WordPress version, matching the plugin header. -->
	<rule ref="WordPress.WP.DeprecatedFunctions">
		<properties>
			<property name="minimum_wp_version" value="6.8"/>
		</properties>
	</rule>

	<!--
		PSR-4 layout uses Studly_Snake_Case class files (Courier_REST_Controller.php),
		which WordPress' hyphenated-lowercase filename sniffs reject.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<!--
		The main plugin file and uninstall.php necessarily mix declarations with
		side effects (constants, hook registration, the WP_UNINSTALL_PLUGIN guard).
	-->
	<rule ref="PSR1.Files.SideEffects">
		<exclude-pattern>./courier-notices.php</exclude-pattern>
		<exclude-pattern>./uninstall.php</exclude-pattern>
		<!-- Emitting markup is what a view template is for. -->
		<exclude-pattern>./templates/*</exclude-pattern>
		<exclude-pattern>./src/blocks/*/render.php</exclude-pattern>
	</rule>
</ruleset>
